set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(WCH_GCC_ROOT "" CACHE PATH "WCH GCC installation containing bin")
find_program(WCH_CC NAMES riscv-none-embed-gcc HINTS "${WCH_GCC_ROOT}/bin" REQUIRED)
get_filename_component(WCH_BIN "${WCH_CC}" DIRECTORY)
set(CMAKE_C_COMPILER "${WCH_CC}")
set(CMAKE_ASM_COMPILER "${WCH_CC}")
find_program(CMAKE_OBJCOPY NAMES riscv-none-embed-objcopy HINTS "${WCH_BIN}" REQUIRED)
find_program(CMAKE_SIZE NAMES riscv-none-embed-size HINTS "${WCH_BIN}" REQUIRED)
set(CMAKE_C_FLAGS_INIT "-march=rv32imc -mabi=ilp32 -mcmodel=medany -msmall-data-limit=8")
set(CMAKE_ASM_FLAGS_INIT "-march=rv32imc -mabi=ilp32 -mcmodel=medany")
